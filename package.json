{
  "name": "swu-bot",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "setup": "npm --prefix forceteki install && npm --prefix forceteki run get-cards && npm --prefix forceteki run build && npm --prefix viewer install && npm --prefix analysis install",
    "gate": "node bot/gate.js",
    "random": "node bot/random-run.js",
    "demo": "node bot/tournament.js --bots random-a,random-b,random-c --games 4 --out replays/demo",
    "tournament": "node bot/tournament.js",
    "viewer:build": "npm --prefix viewer run build",
    "viewer": "npm --prefix viewer run build && node viewer/server.cjs",
    "viewer:dev": "npm --prefix viewer run dev",
    "analyze": "node analysis/analyze.js",
    "analysis:report": "node analysis/report.js",
    "analysis:fitness": "node analysis/fitness.js",
    "analysis:test": "node analysis/test/mock-llm.test.js",
    "ladder": "node bot/ladder.js",
    "test": "node --test bot/test/*.test.js"
  }
}
