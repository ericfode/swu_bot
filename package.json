{
  "name": "swu-bot",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "setup": "bash tools/setup.sh",
    "smoke": "npm test && npm run analysis:test && npm --prefix studio test && npm run viewer:build && npm --prefix studio run build",
    "smoke:source": "node --test --test-skip-pattern='^legacy profile reproduces the original evaluation exactly$' bot/test/*.test.js importer/test/*.test.js app/test/*.test.js && npm run analysis:test && npm --prefix studio test && npm run viewer:build && npm --prefix studio run build",
    "gate": "node bot/gate.js",
    "random": "node bot/random-run.js",
    "demo": "node bot/tournament.js --bots random-a,random-b,random-c --games 4 --out replays/demo",
    "tournament": "node bot/tournament.js",
    "viewer:build": "npm --prefix viewer run build",
    "viewer": "npm --prefix viewer run build && node viewer/server.cjs",
    "viewer:dev": "npm --prefix viewer run dev",
    "app": "node app/build.mjs",
    "studio": "npm --prefix studio run build && npm --prefix studio run preview",
    "studio:dev": "npm --prefix studio run dev",
    "analyze": "node analysis/analyze.js",
    "analysis:report": "node analysis/report.js",
    "analysis:fitness": "node analysis/fitness.js",
    "analysis:test": "npm --prefix analysis test",
    "ladder": "node bot/ladder.js",
    "realdeck:test": "node analysis/realdeck/bot-test.js",
    "test": "node --test bot/test/*.test.js importer/test/*.test.js tools/test/*.test.js app/test/*.test.js",
    "test:py": "python3 -m unittest discover -s bot/python",
    "wasm:build": "node bot/omni-wasm/build.js",
    "wasm:test": "node --test bot/omni-wasm/test.js bot/omni/wasm/test/*.test.js",
    "wasm:check": "node bot/omni/wasm/check.js",
    "wasm:bench": "node bot/omni/wasm/bench.js",
    "lisp:build": "sbcl --non-interactive --load bot/lisp/build.lisp",
    "lisp:test": "sbcl --script bot/lisp/test.lisp",
    "lint": "node tools/bin/perch scan --since origin/main",
    "lint:full": "node tools/bin/perch scan --full",
    "lint:shared": "node tools/bin/perch shared scan --full",
    "perch": "node tools/bin/perch"
  },
  "devDependencies": {
    "@lakeday/perch": "0.4.3",
    "wabt": "1.0.39"
  }
}
