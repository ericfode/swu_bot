{
  "name": "swu-bot",
  "license": "MIT",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "setup": "bash tools/setup.sh",
    "smoke": "npm test",
    "smoke:source": "node --test --test-skip-pattern='^legacy profile reproduces the original evaluation exactly$' bot/test/*.test.js app/test/*.test.js",
    "gate": "node bot/gate.js",
    "dev": "node bot/dev.js",
    "random": "node bot/random-run.js",
    "tournament": "node bot/tournament.js",
    "ladder": "node bot/ladder.js",
    "app": "node app/build.mjs",
    "test": "node --test bot/test/*.test.js tools/test/*.test.js app/test/*.test.js",
    "lint": "node tools/bin/perch scan --since origin/main",
    "lint:full": "node tools/bin/perch scan --full",
    "lint:shared": "node tools/bin/perch shared scan --full",
    "perch": "node tools/bin/perch"
  },
  "devDependencies": {
    "@lakeday/perch": "0.4.3"
  }
}
