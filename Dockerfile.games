# Compatible controller rollout over the exact current immutable execution runtime.
# A changed engine/card/runtime component requires the fresh-image/generation procedure instead.
FROM registry.fly.io/swu-arena-games@sha256:c7817b3af2bd8070d23507823fca1b047ad6bc622e3b4f50b8d46143ae5da3b2 AS preserved
WORKDIR /app
COPY bot/arena/runtime-identity.js bot/arena/compatible-runtime.json /rollout/
RUN node /rollout/runtime-identity.js capture /app --out /rollout/baseline.json

# These are source overlays only. Engine binaries, card data, Node/Python/Wasmtime, toolchain and packages
# remain inherited byte-for-byte. The seal checks every source file, dependency manifest and engine pin;
# only the exact reviewed controller edits may differ, including detection of additions/deletions.
COPY package.json ./
COPY bot bot
COPY server/src server/src
COPY server/package.json server/package-lock.json server/
COPY vendor/kessel vendor/kessel
COPY vendor/jepa vendor/jepa
COPY . /rollout/source
ARG GIT_SHA=unknown
ARG FORCETEKI_SHA=unknown
RUN node bot/arena/runtime-identity.js seal /app --baseline /rollout/baseline.json --source /rollout/source --build "$GIT_SHA" --engine-ref "$FORCETEKI_SHA" \
 && rm -rf /rollout
# Browser/helper packs identify the new controller build while retaining the same actual engine/card runtime.
RUN node bot/swarm/pack.js --root /app --out /app/build/swarm && node bot/swarm/build.js --out /app/build/swarm
# Recheck the complete sealed execution source before either controller or helper can start.
ENTRYPOINT ["/bin/sh", "-ec", "node /app/bot/arena/runtime-identity.js verify /app; exec \"$@\"", "--"]
EXPOSE 8080
CMD ["node", "--disable-warning=ExperimentalWarning", "/app/server/src/main-games.ts"]
