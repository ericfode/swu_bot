# The games machine: what the Fly app swu-arena-games runs (fly.games.toml). It takes the bots people submit on the
# window (swu-arena.fly.dev), plays them against each other and the resident bots, and sends the results back to the
# window. The Elixir coordinator (coord/) runs it and calls Node's bot/arena/gamesctl.js for the game work. Built from the
# repo, forceteki submodule included, by .github/workflows/deploy-games.yml on Fly's builders (never from a thread's
# container). The build context is filtered by Dockerfile.games.dockerignore.
# No stage installs system packages: each takes what it needs from an official image (node, python, rust, Hex's elixir).

# the engine: forceteki built at the commit this repo pins, its card data fetched, only its runtime packages kept
FROM node:22-bookworm AS engine
WORKDIR /src/forceteki
COPY forceteki/package.json forceteki/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY forceteki/ ./
# tsc needs more than Node's default heap: it ran out at about 2 GB on Fly's builder (README.md, "memory")
RUN export NODE_OPTIONS=--max-old-space-size=4096 && npm run get-cards && npm run build \
 && npm prune --omit=dev --no-audit --no-fund

# the Python packages bot/compiled pins (toolchain.json): wasmtime runs the bundles, ziglang compiles the C resident
FROM python:3.12-slim-bookworm AS pydeps
COPY bot/compiled/toolchain.json /toolchain.json
RUN pip install --no-cache-dir --target /opt/zig "ziglang==$(python3 -c "import json; print(json.load(open('/toolchain.json'))['python']['ziglang'])")" \
 && pip install --no-cache-dir --target /opt/py "wasmtime==$(python3 -c "import json; print(json.load(open('/toolchain.json'))['python']['wasmtime'])")"

# the resident bots as WebAssembly bundles (bot/compiled), and the tools the intake packs submissions with: Javy and
# CPython for WASI (pinned in toolchain.json, checked by sha256)
FROM rust:1.97-bookworm AS wasm
RUN rustup target add wasm32-wasip1
COPY --from=node:22-bookworm-slim /usr/local/bin/node /usr/local/bin/node
COPY --from=pydeps /opt/py /opt/py
COPY --from=pydeps /opt/zig /opt/zig
ENV PYTHONPATH=/opt/py:/opt/zig
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY bot bot
RUN python3 bot/compiled/build.py c-clock rust-greedy2 rust-search node-search py-clock \
 && rm -rf build/compiled/.cargo build/compiled/.work build/compiled/.cache build/compiled/.tools/downloads

# the Rust simulator as WebAssembly for Node (bot/omni-wasm/pkg/node), which serves the simulations of a bot that asks
# for them on the Rust engine ("simEngine": "rust", spec/protocol.md); without it such a bot silently gets forceteki
# ones (bot/omni/rs/rust-sims.js). wasm-bindgen-cli at the version build.js pins, in a layer of its own.
FROM rust:1.97-bookworm AS omniwasm
COPY bot/omni-wasm/build.js /build.js
RUN rustup target add wasm32-unknown-unknown \
 && cargo install wasm-bindgen-cli --locked --root /opt/wasm-tools \
      --version "$(sed -n "s/^const bindgenVersion = '\(.*\)';$/\1/p" /build.js)"
COPY --from=node:22-bookworm-slim /usr/local/bin/node /usr/local/bin/node
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY bot bot
RUN WASM_BINDGEN=/opt/wasm-tools/bin/wasm-bindgen node bot/omni-wasm/build.js --target node

# the Elixir coordinator as a release (coord/): Erlang and Elixir from Hex's official image, built on the rust image
# because it has gcc (exqlite's SQLite is compiled from source, config :exqlite, force_build: true). All three images
# are Debian bookworm, so the release runs on the final image's glibc.
FROM hexpm/elixir:1.19.6-erlang-28.5.0.7-debian-bookworm-20260918-slim AS beam
FROM rust:1.97-bookworm AS coord
COPY --from=beam /usr/local/lib/erlang /usr/local/lib/erlang
COPY --from=beam /usr/local/lib/elixir /usr/local/lib/elixir
RUN for b in erl erlc escript; do ln -s ../lib/erlang/bin/$b /usr/local/bin/$b; done \
 && for b in elixir elixirc mix; do ln -s ../lib/elixir/bin/$b /usr/local/bin/$b; done
ENV LANG=C.UTF-8 MIX_ENV=prod
WORKDIR /src/coord
RUN mix local.hex --force && mix local.rebar --force
COPY coord/mix.exs coord/mix.lock ./
COPY coord/config config
RUN mix deps.get --only prod && mix deps.compile
COPY coord/lib lib
COPY coord/priv priv
COPY coord/rel rel
RUN mix release --path /opt/coord && chmod 600 /opt/coord/releases/COOKIE

# python3 runs bundles under wasmtime (bot/compiled/run.py); bash, unshare and setpriv run isolate.sh; the bots and the
# intake's checker run as the user arena
FROM python:3.12-slim-bookworm
COPY --from=node:22-bookworm-slim /usr/local/bin/node /usr/local/bin/node
COPY --from=pydeps /opt/py /usr/local/lib/python3.12/site-packages
RUN useradd --system --user-group --no-create-home --home-dir /data/home --shell /usr/sbin/nologin arena
ENV NODE_ENV=production GAMES_DATA=/data PORT=8080
WORKDIR /app
COPY package.json ./
COPY bot bot
COPY --from=engine /src/forceteki/package.json forceteki/package.json
COPY --from=engine /src/forceteki/build forceteki/build
COPY --from=engine /src/forceteki/node_modules forceteki/node_modules
COPY --from=engine /src/forceteki/test/json forceteki/test/json
COPY --from=wasm /src/build/compiled build/compiled
COPY --from=omniwasm /src/bot/omni-wasm/pkg/node bot/omni-wasm/pkg/node
COPY --from=coord /opt/coord /app/coord
# the release starts here: crypto, SQLite and the CA store load (runtime.exs needs a window address to load)
RUN SWU_WINDOW=http://window.invalid /app/coord/bin/coord eval 'true = byte_size(:crypto.strong_rand_bytes(8)) == 8; {:ok, _} = Exqlite.Sqlite3.open(":memory:"); true = :public_key.cacerts_get() != []'
# What a helper must match to play this machine's games (bot/arena/HELPER.md): the commit the image was built from
# (deploy-games.yml passes it) and a hash of the card data fetched above. Last, so a new commit rebuilds only this.
ARG GIT_SHA=unknown
RUN printf '%s\n' "$GIT_SHA" > /app/BUILD_SHA \
 && (cd /app/forceteki/test/json && find . -type f -print0 | LC_ALL=C sort -z | xargs -0 sha256sum | sha256sum | cut -d' ' -f1) > /app/CARDS_SHA
# The browser swarm's files (bot/swarm, spec/executor.md), made from this image as it is so they carry its BUILD_SHA
# and CARDS_SHA: the engine and bots as one pack, Python's interpreter, the tab's workers. The window serves them
# through the helper API (GET /v1/swarm/<file>).
RUN node bot/swarm/pack.js --root /app --out /app/build/swarm && node bot/swarm/build.js --out /app/build/swarm
EXPOSE 8080
CMD ["/app/coord/bin/coord", "start"]
