;;;; Minimal JSON reader and writer, so the bot needs nothing beyond SBCL.
;;;;
;;;; Objects read as EQUAL hash tables, arrays as lists, true as T, false as :FALSE, null as :NULL.
;;;; The writer takes the same shapes, plus alists tagged (:obj ("k" . v) ...) for literal objects.

(in-package :swu)

(define-condition json-error (error)
  ((text :initarg :text :reader json-error-text))
  (:report (lambda (c s) (format s "bad JSON: ~a" (json-error-text c)))))

(defun parse-json (input)
  (let* ((string (coerce input 'simple-string))
         (pos 0)
         (len (length string)))
    (declare (type fixnum pos len) (type simple-string string))
    (labels ((fail (why) (error 'json-error :text (format nil "~a at ~d" why pos)))
             (peek () (if (< pos len) (schar string pos) nil))
             (skip-ws ()
               (loop while (and (< pos len) (member (schar string pos) '(#\Space #\Tab #\Newline #\Return)))
                     do (incf pos)))
             (expect (ch)
               (skip-ws)
               (unless (eql (peek) ch) (fail (format nil "expected ~a" ch)))
               (incf pos))
             (literal (word value)
               (if (and (<= (+ pos (length word)) len) (string= word string :start2 pos :end2 (+ pos (length word))))
                   (progn (incf pos (length word)) value)
                   (fail "bad literal")))
             (hex4 ()
               (when (> (+ pos 4) len) (fail "short \\u escape"))
               (prog1 (parse-integer string :start pos :end (+ pos 4) :radix 16)
                 (incf pos 4)))
             (read-string ()
               (incf pos)                ; opening quote
               (let ((out (make-string-output-stream)))
                 (loop
                   (when (>= pos len) (fail "unterminated string"))
                   (let ((ch (schar string pos)))
                     (incf pos)
                     (cond ((char= ch #\") (return (get-output-stream-string out)))
                           ((char= ch #\\)
                            (let ((e (schar string pos)))
                              (incf pos)
                              (case e
                                (#\n (write-char #\Newline out))
                                (#\t (write-char #\Tab out))
                                (#\r (write-char #\Return out))
                                (#\b (write-char #\Backspace out))
                                (#\f (write-char #\Page out))
                                (#\u (let ((code (hex4)))
                                       ;; surrogate pair
                                       (when (and (<= #xD800 code #xDBFF) (< (+ pos 1) len)
                                                  (char= (schar string pos) #\\) (char= (schar string (1+ pos)) #\u))
                                         (incf pos 2)
                                         (let ((lo (hex4)))
                                           (setf code (+ #x10000 (ash (- code #xD800) 10) (- lo #xDC00)))))
                                       (write-char (code-char code) out)))
                                (t (write-char e out)))))
                           (t (write-char ch out)))))))
             (read-number ()
               (let ((start pos) (float nil))
                 (loop while (and (< pos len)
                                  (let ((c (schar string pos)))
                                    (or (digit-char-p c) (member c '(#\- #\+)) (and (member c '(#\. #\e #\E)) (setf float t)))))
                       do (incf pos))
                 (if float
                     (let ((*read-default-float-format* 'double-float))
                       (coerce (let ((*read-eval* nil)) (read-from-string string t nil :start start :end pos)) 'double-float))
                     (parse-integer string :start start :end pos))))
             (read-value ()
               (skip-ws)
               (let ((ch (peek)))
                 (case ch
                   (#\{ (incf pos)
                    (let ((table (make-hash-table :test 'equal)))
                      (skip-ws)
                      (if (eql (peek) #\})
                          (incf pos)
                          (loop
                            (skip-ws)
                            (unless (eql (peek) #\") (fail "expected key"))
                            (let ((key (read-string)))
                              (expect #\:)
                              (setf (gethash key table) (read-value)))
                            (skip-ws)
                            (case (peek)
                              (#\, (incf pos))
                              (#\} (incf pos) (return))
                              (t (fail "expected , or }")))))
                      table))
                   (#\[ (incf pos)
                    (skip-ws)
                    (if (eql (peek) #\])
                        (progn (incf pos) nil)
                        (loop with items = '()
                              do (push (read-value) items)
                                 (skip-ws)
                                 (case (peek)
                                   (#\, (incf pos))
                                   (#\] (incf pos) (return (nreverse items)))
                                   (t (fail "expected , or ]"))))))
                   (#\" (read-string))
                   (#\t (literal "true" t))
                   (#\f (literal "false" :false))
                   (#\n (literal "null" :null))
                   ((nil) (fail "unexpected end"))
                   (t (if (or (digit-char-p ch) (char= ch #\-))
                          (read-number)
                          (fail (format nil "unexpected ~s" ch))))))))
      (prog1 (read-value)
        (skip-ws)))))

(defun jget (obj &rest path)
  "Follow string keys (hash tables) and integer indexes (lists). Missing, null or false -> NIL."
  (dolist (k path)
    (setf obj (cond ((and (stringp k) (hash-table-p obj)) (gethash k obj))
                    ((and (integerp k) (listp obj)) (nth k obj))
                    (t nil))))
  (if (member obj '(:null :false)) nil obj))

(defun jnum (obj &rest path)
  (let ((v (apply #'jget obj path)))
    (if (numberp v) v 0)))

(defun write-json-string (s out)
  (write-char #\" out)
  (loop for ch across s
        do (case ch
             (#\" (write-string "\\\"" out))
             (#\\ (write-string "\\\\" out))
             (#\Newline (write-string "\\n" out))
             (#\Return (write-string "\\r" out))
             (#\Tab (write-string "\\t" out))
             (t (if (< (char-code ch) 32)
                    (format out "\\u~4,'0x" (char-code ch))
                    (write-char ch out)))))
  (write-char #\" out))

(defun write-json (v out)
  (cond ((eq v t) (write-string "true" out))
        ((eq v :false) (write-string "false" out))
        ((or (eq v :null) (null v)) (write-string "null" out))
        ((stringp v) (write-json-string v out))
        ((integerp v) (format out "~d" v))
        ((realp v) (format out "~,6f" v))
        ((and (consp v) (eq (car v) :obj))
         (write-char #\{ out)
         (loop for (k . val) in (cdr v)
               for first = t then nil
               do (unless first (write-char #\, out))
                  (write-json-string k out)
                  (write-char #\: out)
                  (write-json val out))
         (write-char #\} out))
        ((listp v)
         (write-char #\[ out)
         (loop for x in v for first = t then nil
               do (unless first (write-char #\, out))
                  (write-json x out))
         (write-char #\] out))
        ((hash-table-p v)
         (write-json (cons :obj (loop for k being the hash-keys of v using (hash-value x) collect (cons k x))) out))
        (t (write-json (princ-to-string v) out))))

(defun json-string (v)
  (with-output-to-string (s) (write-json v s)))
