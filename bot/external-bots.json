{
    "py-random": { "cmd": "python3", "args": ["bot/examples/random_bot.py"], "stderr": "ignore" },
    "rust-random": { "cmd": "bot/rust/target/release/swu-bot-rs", "args": ["random"] },
    "rust-greedy": { "cmd": "bot/rust/target/release/swu-bot-rs", "args": ["greedy"] },
    "rust-learned": { "cmd": "bot/rust-learned/target/release/swu-learned", "args": ["play", "--model", "bot/rust-learned/models/learned-v1.safetensors", "--name", "rust-learned"], "stderr": "ignore" },
    "rust-learned-world": { "cmd": "bot/rust-learned/target/release/swu-learned", "args": ["play", "--model", "bot/rust-learned/models/learned-v1.safetensors", "--world", "1", "--name", "rust-learned-world"], "stderr": "ignore" },
    "rust-learned-heur": { "cmd": "bot/rust-learned/target/release/swu-learned", "args": ["play", "--model", "bot/rust-learned/models/learned-v1.safetensors", "--heur", "1", "--name", "rust-learned-heur"], "stderr": "ignore" }
}
