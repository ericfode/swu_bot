cabal-version:      2.4
name:               swu-bot-hs
version:            0.1.0
synopsis:           Star Wars Unlimited bot in Haskell over the swu-bot stdio protocol
license:            NONE
build-type:         Simple

executable swu-bot-hs
    main-is:          Main.hs
    hs-source-dirs:   app, src
    other-modules:    Cards, Protocol, Model, Effects, Search, Policy
    build-depends:    base >=4.14 && <5, aeson >=2.0 && <2.3, bytestring, containers, text,
                      directory, filepath, scientific
    default-language: Haskell2010
    ghc-options:      -O2 -Wall -Wno-name-shadowing -Wno-unused-do-bind
