#!/bin/sh
# Stands in for node in the tests (config/test.exs points Coord.Config node here), started by the real Coord.Proc:
#
#   fake_node <app>/bot/arena/gamesctl.js <command> [args...]     a gamesctl command
#   fake_node <app>/bot/arena/referee.js [args...]                the referee (from the default referee-cmd)
#
# A child gets no variable the tests could set, so the fake's folder is $GAMES_DATA, or for the referee (whose
# environment is referee-cmd's) the folder above $ARENA_HOME. In it:
#   fake-node.log        it appends "start <name> <args>", one "env <name> K=V" per variable, and at the end
#                        "end <name> <code>", or "term <name>" when SIGTERM stopped it
#   fake/<name>.json     what it prints on stdout (else a canned result for that command)
#   fake/<name>.exit     its exit code (else 0)
#   fake/<name>.sleep    seconds to sleep first, in the background, so that a group kill has two processes to stop
#   fake/<name>.noterm   ignore SIGTERM (only KILL stops it)
#   fake-node.stderr     its stderr
set -u
script=$1
shift
case "$script" in
*/gamesctl.js)
    name=$1
    shift
    ;;
*) name=$(basename "$script" .js) ;;
esac
dir=${GAMES_DATA:-${ARENA_HOME%/arena}}
log=$dir/fake-node.log
ctl=$dir/fake/$name
# the shell's own messages ("Terminated" when a TERM lands during a foreground command) go to a file, not to the
# test run's output
exec 2>>"$dir/fake-node.stderr"

echo "start $name $*" >>"$log"
env | sort | sed "s|^|env $name |" >>"$log"

if [ -f "$ctl.noterm" ]; then
    trap '' TERM
else
    trap 'echo "term $name" >>"$log"; exit 143' TERM
fi

if [ -f "$ctl.sleep" ]; then
    # wait returns early when TERM arrives (and the trap exits); an ignored TERM is ignored by the sleep too
    sleep "$(cat "$ctl.sleep")" &
    wait $!
fi

round=
prev=
for a in "$@"; do
    [ "$prev" = --round ] && round=$a
    prev=$a
done

if [ -f "$ctl.json" ]; then
    cat "$ctl.json"
else
    case "$name" in
    setup) echo '{"ok":true,"residents":["heuristic","rush"],"toolchain":null}' ;;
    warm) echo '{"ok":true,"warmed":["c-clock-wasm"],"failed":[]}' ;;
    plan) echo '{"round":null,"why":"same"}' ;;
    referee-cmd)
        here=$(cd "$(dirname "$0")" && pwd)/$(basename "$0")
        printf '{"cmd":["%s","%s/referee.js","--round","%s","--games","2","--workers","2"],' \
            "$here" "$(dirname "$script")" "$round"
        printf '"env":{"PATH":"/usr/bin:/bin","HOME":"%s/home","LANG":"C.UTF-8","TZ":"UTC","ARENA_HOME":"%s/arena"},' \
            "$dir" "$dir"
        printf '"cwd":"%s"}\n' "$(pwd)"
        ;;
    intake) echo '{"open":0,"accepted":0,"done":0}' ;;
    push) echo '{"ok":true}' ;;
    referee)
        echo "round $round: game 1 of 2"
        echo "round $round: game 2 of 2"
        ;;
    esac
fi

code=0
[ -f "$ctl.exit" ] && code=$(cat "$ctl.exit")
echo "end $name $code" >>"$log"
exit "$code"
