#!/usr/bin/env node
// Runs perch (the @lakeday/perch semantic linter) against TypeSafe Jev instead of Perch Cloud,
// on the project's shared core only, with limits so that every thread can use it.
//
// Environment, only filled in when the caller has not set it:
// - PERCH_BASE_URL: the TypeSafe System One endpoint. perch then defaults the model to jev-latest.
// - PERCH_API_KEY: perch falls back to TYPESAFE_API_KEY. In a Claude Code cloud session any value
//   works, because the egress proxy injects the real Jev key for api.typesafe.ai.
// - NODE_USE_ENV_PROXY: Node's fetch ignores HTTPS_PROXY without it, so perch could not reach Jev.
// - PERCH_JEV_DIR: where the Jev answer cache, the usage ledger and the DISABLED switch live:
//   /mnt/project-files/perch when that folder exists (so threads share answers and one daily
//   budget), else .perch/jev in this repo. tools/perch/jev-cache.mjs does the caching and budget.
//
// Every perch command that reads code or findings runs in a snapshot: a scratch git repo under
// .perch/ that holds only the files in tools/perch/scope.js (the shared core, not the bots) at HEAD,
// so Jev never sees anything else. check also sees uncommitted in-scope changes. perch keeps its
// findings there; the closed ones are added back to .perch/closed.jsonl in this repo.
// `perch shared <command>` does the same for the code in the shared project folder.
//
// Limits on the commands that ask Jev (scan and check), set in tools/perch/policy.js:
// - scan needs a scope (a path, --since or --paths); everything in scope needs --full.
// - coverage is refused: it measures tests, and tests are out of scope.
// - --parallel defaults to 8 instead of perch's 32.
// - One perch command at a time per checkout, Jev commands stopped after PERCH_TIMEOUT_MIN minutes
//   (default 15).
// - PERCH_DISABLED=1, or a file named DISABLED in PERCH_JEV_DIR, skips them and exits 0.
// `perch usage [days]` sums the ledger.
'use strict';
const { spawnSync } = require('node:child_process');
const fs = require('node:fs');
const path = require('node:path');
const { pathToFileURL } = require('node:url');
const { parseArgs, plan, asksJev, usesSnapshot, gitEnv, readDay, holdLock, snapshotRepo, snapshotShared, appendNew, readBytes } = require('../perch/policy.js');
const scopes = require('../perch/scope.js');

const repo = path.resolve(__dirname, '../..');
// Without the variables git sets for hooks, so perch and every git process find the repo they run in.
const env = gitEnv(process.env);
const sharedFolder = '/mnt/project-files';
const jevDir = env.PERCH_JEV_DIR || (fs.existsSync(sharedFolder) ? path.join(sharedFolder, 'perch') : path.join(repo, '.perch', 'jev'));
env.PERCH_CACHE_DIR ||= path.join(jevDir, 'cache');
env.PERCH_USAGE_DIR ||= path.join(jevDir, 'usage');
env.PERCH_DAILY_REQUESTS ||= '1000';
env.PERCH_RUN_REQUESTS ||= '250';
// perch sends at most 8 questions in its first request until Jev has answered once, so a method
// could be asked in two different requests. A fixed limit keeps requests, and cache keys, the same.
env.PERCH_MAX_QUESTIONS ||= '64';

let args = process.argv.slice(2);
if (args[0] === 'usage') {
  printUsage(Number(args[1]) || 1);
  process.exit(0);
}
const shared = args[0] === 'shared';
if (shared) args = args.slice(1);
const jev = asksJev(args);
const snap = usesSnapshot(args);
const off = env.PERCH_DISABLED === '1' ? 'PERCH_DISABLED=1' : fs.existsSync(path.join(jevDir, 'DISABLED')) && path.join(jevDir, 'DISABLED');
if (jev && off) {
  console.error(`perch is turned off (${off}); skipped ${parseArgs(args).positionals[0]}.`);
  process.exit(0);
}
if (shared && !snap) {
  console.error('perch: `perch shared` runs scan, check, issues, close, reopen and doctor. rules and setup change this repo\'s own config: run them without `shared`.');
  process.exit(2);
}
// rules, setup and the Perch Cloud commands read no code and edit this repo's config, so they run here.
const workRoot = snap ? path.join(repo, '.perch', shared ? 'shared' : 'core') : repo;
const closures = shared ? path.join(jevDir, 'shared', 'closed.jsonl') : path.join(repo, '.perch', 'closed.jsonl');
// In this repo, the arguments are checked before the snapshot is made, since --since needs the
// repo's history. In the shared folder, the snapshot is the only repo there is.
let run = shared ? null : stopIfDone(plan(args, { repo, scope: scopes.repo }));

if (snap) {
  // Commands that ask Jev do not wait for another run; quick ones such as issues and close wait a little.
  const lock = holdLock(path.join(repo, '.perch', 'wrapper.lock'), jev ? 0 : 30e3);
  if (!lock.held) {
    console.error(`perch: another perch run (pid ${lock.holder}) is using this checkout. Wait for it, or delete ${lock.file} if none is running.`);
    process.exit(1);
  }
  process.on('exit', lock.release);
  if (shared) {
    snapshotShared(scopes.shared, workRoot, closures);
    run = stopIfDone(plan(args, { repo: workRoot, scope: null, cwd: workRoot }));
  } else {
    // check asks about work in progress, so it sees uncommitted in-scope changes too.
    snapshotRepo(repo, scopes.repo, workRoot, { workingTree: run.command === 'check' });
  }
  // If the snapshot's .git were ever broken, git must not climb out of it into this repo.
  env.GIT_CEILING_DIRECTORIES = [fs.realpathSync(path.dirname(workRoot)), env.GIT_CEILING_DIRECTORIES].filter(Boolean).join(':');
}
Object.assign(env, run.env);

// The repo's own install first, then a global `npm install -g` next to this node binary.
const searchPaths = [repo, path.resolve(process.execPath, '../../lib')];
let bin;
try {
  bin = require.resolve('@lakeday/perch/bin/perch.mjs', { paths: searchPaths });
} catch {
  console.error('perch is not installed: run `npm install` in the swu_bot repo root.');
  process.exit(1);
}

env.PERCH_BASE_URL ||= 'https://api.typesafe.ai/v1/systemone';
if (!env.PERCH_API_KEY && !env.TYPESAFE_API_KEY && env.CLAUDE_CODE_REMOTE === 'true') {
  env.PERCH_API_KEY = 'injected-by-proxy';
}
if ((env.HTTPS_PROXY || env.https_proxy) && !env.NODE_USE_ENV_PROXY) {
  // Node reads NODE_USE_ENV_PROXY from v22.21 and v24.0; older versions would bypass the proxy.
  const [major, minor] = process.versions.node.split('.').map(Number);
  if (major < 22 || major === 23 || (major === 22 && minor < 21)) {
    console.error(`perch: Node ${process.version} ignores HTTPS_PROXY for fetch, so Jev may be unreachable. Use Node 22.21+ or 24+.`);
  }
  env.NODE_USE_ENV_PROXY = '1';
  // Node prints an "EnvHttpProxyAgent is experimental" warning on every start otherwise.
  env.NODE_OPTIONS = [env.NODE_OPTIONS, '--disable-warning=UNDICI-EHPA'].filter(Boolean).join(' ');
}

const minutes = Number(env.PERCH_TIMEOUT_MIN) > 0 ? Number(env.PERCH_TIMEOUT_MIN) : 15;
const preload = pathToFileURL(path.join(repo, 'tools/perch/jev-cache.mjs')).href;
const localClosures = path.join(workRoot, '.perch', 'closed.jsonl');
const before = snap && readBytes(localClosures);
const child = spawnSync(process.execPath, ['--import', preload, bin, ...run.args], {
  cwd: workRoot,
  stdio: 'inherit',
  env,
  timeout: jev ? Math.round(minutes * 60e3) : undefined,
});
if (snap) appendNew(localClosures, before, closures);
if (child.error?.code === 'ETIMEDOUT') {
  console.error(`perch: stopped after ${minutes} min (PERCH_TIMEOUT_MIN).`);
  process.exit(1);
}
if (child.error) throw child.error;
process.exit(child.status ?? 1);

/** Exits for a plan that refuses (2) or has nothing to read (0); returns any other plan. */
function stopIfDone(run) {
  if (run.error) {
    console.error(run.error);
    process.exit(2);
  }
  if (run.nothing) {
    console.log(run.nothing);
    process.exit(0);
  }
  return run;
}

/** One line per UTC day from the ledger that tools/perch/jev-cache.mjs writes. */
function printUsage(days) {
  console.log(`Jev usage in ${env.PERCH_USAGE_DIR} (daily limit ${env.PERCH_DAILY_REQUESTS}, per run ${env.PERCH_RUN_REQUESTS})`);
  for (let back = days - 1; back >= 0; back--) {
    const date = new Date(Date.now() - back * 86400e3).toISOString().slice(0, 10);
    const runs = readDay(env.PERCH_USAGE_DIR, date);
    const sum = (key) => runs.reduce((total, r) => total + (r[key] || 0), 0);
    console.log(`${date}  runs ${runs.length}  asked ${sum('asked')}  cached ${sum('hits')}  refused ${sum('refused')}  ` +
      `tokens ${sum('input_tokens')} in / ${sum('output_tokens')} out  sessions ${new Set(runs.map((r) => r.session)).size}`);
  }
}
