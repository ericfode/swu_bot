#!/usr/bin/env node
// Runs perch (the @lakeday/perch semantic linter) against TypeSafe Jev instead of Perch Cloud,
// with limits so that every thread can use it without running up Jev requests.
//
// Environment, only filled in when the caller has not set it:
// - PERCH_BASE_URL: the TypeSafe System One endpoint. perch then defaults the model to jev-latest.
// - PERCH_API_KEY: perch falls back to TYPESAFE_API_KEY. In a Claude Code cloud session any value
//   works, because the egress proxy injects the real Jev key for api.typesafe.ai.
// - NODE_USE_ENV_PROXY: Node's fetch ignores HTTPS_PROXY without it, so perch could not reach Jev.
// - PERCH_JEV_DIR: where the Jev answer cache, the usage ledger and the DISABLED switch live:
//   /mnt/project-files/perch when that folder exists (so threads share answers and one daily
//   budget), else .perch/jev in this repo. tools/perch/jev-cache.mjs does the caching and budget.
//
// Limits on the commands that ask Jev (scan, coverage, check):
// - scan needs a scope (a path, --since or --paths), coverage a path or --paths; the whole repo
//   needs --full. tools/perch/policy.js reads the arguments.
// - --parallel defaults to 8 instead of perch's 32.
// - One run at a time per checkout, stopped after PERCH_TIMEOUT_MIN minutes (default 15).
// - PERCH_DISABLED=1, or a file named DISABLED in PERCH_JEV_DIR, skips them and exits 0.
// `perch usage [days]` sums the ledger.
'use strict';
const { spawnSync } = require('node:child_process');
const fs = require('node:fs');
const path = require('node:path');
const { pathToFileURL } = require('node:url');
const { plan, readDay, holdLock } = require('../perch/policy.js');

const repo = path.resolve(__dirname, '../..');
const env = { ...process.env };
const shared = '/mnt/project-files';
const jevDir = env.PERCH_JEV_DIR || (fs.existsSync(shared) ? path.join(shared, 'perch') : path.join(repo, '.perch', 'jev'));
env.PERCH_CACHE_DIR ||= path.join(jevDir, 'cache');
env.PERCH_USAGE_DIR ||= path.join(jevDir, 'usage');
env.PERCH_DAILY_REQUESTS ||= '1000';
env.PERCH_RUN_REQUESTS ||= '250';

const args = process.argv.slice(2);
if (args[0] === 'usage') {
  printUsage(Number(args[1]) || 1);
  process.exit(0);
}
const run = plan(args, { repo });
if (run.asksJev) {
  const off = env.PERCH_DISABLED === '1' ? 'PERCH_DISABLED=1' : fs.existsSync(path.join(jevDir, 'DISABLED')) && path.join(jevDir, 'DISABLED');
  if (off) {
    console.error(`perch is turned off (${off}); skipped ${run.command}.`);
    process.exit(0);
  }
}
if (run.error) {
  console.error(run.error);
  process.exit(2);
}
if (run.since && spawnSync('git', ['rev-parse', '--verify', '--quiet', `${run.since}^{commit}`]).status !== 0) {
  console.error(`perch: ${run.since} is not a commit in this checkout. Run \`git fetch origin main\` first.`);
  process.exit(2);
}
Object.assign(env, run.env);

// The repo's own install first, then a global `npm install -g` next to this node binary.
const searchPaths = [repo, path.resolve(process.execPath, '../../lib')];
let bin;
try {
  bin = require.resolve('@lakeday/perch/bin/perch.mjs', { paths: searchPaths });
} catch {
  console.error('perch is not installed: run `npm install` in the swu_bot repo root.');
  process.exit(1);
}

env.PERCH_BASE_URL ||= 'https://api.typesafe.ai/v1/systemone';
if (!env.PERCH_API_KEY && !env.TYPESAFE_API_KEY && env.CLAUDE_CODE_REMOTE === 'true') {
  env.PERCH_API_KEY = 'injected-by-proxy';
}
if ((env.HTTPS_PROXY || env.https_proxy) && !env.NODE_USE_ENV_PROXY) {
  // Node reads NODE_USE_ENV_PROXY from v22.21 and v24.0; older versions would bypass the proxy.
  const [major, minor] = process.versions.node.split('.').map(Number);
  if (major < 22 || major === 23 || (major === 22 && minor < 21)) {
    console.error(`perch: Node ${process.version} ignores HTTPS_PROXY for fetch, so Jev may be unreachable. Use Node 22.21+ or 24+.`);
  }
  env.NODE_USE_ENV_PROXY = '1';
  // Node prints an "EnvHttpProxyAgent is experimental" warning on every start otherwise.
  env.NODE_OPTIONS = [env.NODE_OPTIONS, '--disable-warning=UNDICI-EHPA'].filter(Boolean).join(' ');
}

if (run.asksJev) {
  const lock = holdLock(path.join(repo, '.perch', 'wrapper.lock'));
  if (!lock.held) {
    console.error(`perch: another perch run (pid ${lock.holder}) is using this checkout. Wait for it, or delete ${lock.file} if none is running.`);
    process.exit(1);
  }
  process.on('exit', lock.release);
}
const minutes = Number(env.PERCH_TIMEOUT_MIN) > 0 ? Number(env.PERCH_TIMEOUT_MIN) : 15;
const preload = pathToFileURL(path.join(repo, 'tools/perch/jev-cache.mjs')).href;
const child = spawnSync(process.execPath, ['--import', preload, bin, ...run.args], {
  stdio: 'inherit',
  env,
  timeout: run.asksJev ? Math.round(minutes * 60e3) : undefined,
});
if (child.error?.code === 'ETIMEDOUT') {
  console.error(`perch: stopped after ${minutes} min (PERCH_TIMEOUT_MIN).`);
  process.exit(1);
}
if (child.error) throw child.error;
process.exit(child.status ?? 1);

/** One line per UTC day from the ledger that tools/perch/jev-cache.mjs writes. */
function printUsage(days) {
  console.log(`Jev usage in ${env.PERCH_USAGE_DIR} (daily limit ${env.PERCH_DAILY_REQUESTS}, per run ${env.PERCH_RUN_REQUESTS})`);
  for (let back = days - 1; back >= 0; back--) {
    const date = new Date(Date.now() - back * 86400e3).toISOString().slice(0, 10);
    const runs = readDay(env.PERCH_USAGE_DIR, date);
    const sum = (key) => runs.reduce((total, r) => total + (r[key] || 0), 0);
    console.log(`${date}  runs ${runs.length}  asked ${sum('asked')}  cached ${sum('hits')}  refused ${sum('refused')}  ` +
      `tokens ${sum('input_tokens')} in / ${sum('output_tokens')} out  sessions ${new Set(runs.map((r) => r.session)).size}`);
  }
}
