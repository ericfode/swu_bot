{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thrazznos/swu_bot/spec/schemas/protocol.schema.json",
  "title": "SWU bot protocol v2 (and v1), one message",
  "description": "Referee -> bot: hello, decide, simulated, over, bye. Bot -> referee: ready, act, sim, ok, error. Unknown fields must be ignored. See spec/protocol.md.",
  "oneOf": [
    {
      "$ref": "#/$defs/Hello"
    },
    {
      "$ref": "#/$defs/Ready"
    },
    {
      "$ref": "#/$defs/Decide"
    },
    {
      "$ref": "#/$defs/Act"
    },
    {
      "$ref": "#/$defs/Sim"
    },
    {
      "$ref": "#/$defs/Simulated"
    },
    {
      "$ref": "#/$defs/Over"
    },
    {
      "$ref": "#/$defs/Ok"
    },
    {
      "$ref": "#/$defs/Bye"
    },
    {
      "$ref": "#/$defs/Error"
    }
  ],
  "$defs": {
    "Seat": {
      "enum": [
        "p1",
        "p2"
      ]
    },
    "Flag": {
      "enum": [
        0,
        1
      ]
    },
    "SetCode": {
      "type": [
        "string",
        "null"
      ]
    },
    "Ms": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "description": "Milliseconds the bot has for its final reply, counted from when this message was sent; null = no limit. On simulated: the time left for the decision."
    },
    "Split": {
      "type": "array",
      "description": "Only for a distribute action: [{id, amount}]. Omit to let the referee pick a random legal split.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "amount"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "amount": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "DeckEntry": {
      "type": "object",
      "required": [
        "id",
        "count"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Set code <SET>_<NNN>."
        },
        "count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "DeckList": {
      "type": "object",
      "required": [
        "leader",
        "base",
        "deck"
      ],
      "properties": {
        "metadata": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "author": {
              "type": "string"
            }
          }
        },
        "leader": {
          "$ref": "#/$defs/DeckEntry"
        },
        "base": {
          "$ref": "#/$defs/DeckEntry"
        },
        "deck": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DeckEntry"
          }
        }
      }
    },
    "Hello": {
      "type": "object",
      "description": "The same envelope in every version (protocol, v: 1, bot), so any bot can read it; the bot picks the version in ready.",
      "required": [
        "t",
        "protocol",
        "v",
        "bot",
        "you",
        "seed",
        "players"
      ],
      "properties": {
        "t": {
          "const": "hello"
        },
        "protocol": {
          "const": "swu-bot-stdio"
        },
        "v": {
          "const": 1
        },
        "versions": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "description": "Versions the referee speaks (v2 field)."
        },
        "bot": {
          "type": "string"
        },
        "you": {
          "$ref": "#/$defs/Seat"
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "ms": {
          "$ref": "#/$defs/Ms"
        },
        "players": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/Seat"
              },
              "name": {
                "type": "string"
              },
              "bot": {
                "type": "string"
              }
            }
          }
        },
        "deck": {
          "$ref": "#/$defs/DeckList",
          "description": "Your deck list (v2 field)."
        },
        "opponent": {
          "$ref": "#/$defs/DeckList",
          "description": "The opponent's deck list; lists are open (v2 field)."
        }
      }
    },
    "Ready": {
      "type": "object",
      "required": [
        "t"
      ],
      "properties": {
        "t": {
          "const": "ready"
        },
        "v": {
          "enum": [
            1,
            2
          ],
          "description": "Chosen version; omitted = 1."
        },
        "name": {
          "type": "string"
        },
        "sim": {
          "type": "boolean",
          "description": "v2: ask for simulations."
        }
      }
    },
    "Over": {
      "type": "object",
      "required": [
        "t",
        "you",
        "winner",
        "outcome",
        "round",
        "steps"
      ],
      "properties": {
        "t": {
          "const": "over"
        },
        "you": {
          "$ref": "#/$defs/Seat"
        },
        "winner": {
          "enum": [
            "p1",
            "p2",
            "draw",
            null
          ]
        },
        "outcome": {
          "enum": [
            "won",
            "STEP_CAP",
            "STUCK",
            "ERROR"
          ]
        },
        "round": {
          "type": "integer"
        },
        "steps": {
          "type": "integer",
          "minimum": 0
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "by": {
          "enum": [
            "p1",
            "p2",
            null
          ],
          "description": "For ERROR: the seat that caused it, which loses (winner is the other seat); null = engine or referee, no winner."
        },
        "ms": {
          "$ref": "#/$defs/Ms"
        }
      }
    },
    "Ok": {
      "type": "object",
      "required": [
        "t"
      ],
      "properties": {
        "t": {
          "const": "ok"
        }
      }
    },
    "Bye": {
      "type": "object",
      "required": [
        "t"
      ],
      "properties": {
        "t": {
          "const": "bye"
        }
      },
      "description": "End of session on bindings without end-of-file; no reply."
    },
    "Sim": {
      "type": "object",
      "required": [
        "t",
        "op"
      ],
      "properties": {
        "t": {
          "const": "sim"
        },
        "op": {
          "enum": [
            "begin",
            "act",
            "end"
          ]
        },
        "i": {
          "type": "integer",
          "minimum": 0,
          "description": "act: index into the last position's actions."
        },
        "split": {
          "$ref": "#/$defs/Split"
        },
        "deal": {
          "type": "integer",
          "minimum": 0,
          "description": "begin: deal number; the same number in one decision deals the same cards and random outcomes. Omitted: a new deal."
        }
      },
      "if": {
        "properties": {
          "op": {
            "const": "act"
          }
        }
      },
      "then": {
        "required": [
          "i"
        ]
      }
    },
    "Simulated": {
      "type": "object",
      "required": [
        "t",
        "op"
      ],
      "properties": {
        "t": {
          "const": "simulated"
        },
        "op": {
          "enum": [
            "begin",
            "act",
            "end",
            null
          ]
        },
        "actor": {
          "$ref": "#/$defs/Seat"
        },
        "prompt": {
          "$ref": "#/$defs/Prompt"
        },
        "state": {
          "$ref": "#/$defs/Observation"
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Action"
          }
        },
        "over": {
          "type": "object",
          "required": [
            "winner"
          ],
          "properties": {
            "winner": {
              "enum": [
                "p1",
                "p2",
                "draw",
                null
              ]
            }
          }
        },
        "error": {
          "type": "string"
        },
        "ms": {
          "$ref": "#/$defs/Ms"
        }
      },
      "oneOf": [
        {
          "required": [
            "actor",
            "prompt",
            "state",
            "actions"
          ]
        },
        {
          "required": [
            "over"
          ]
        },
        {
          "required": [
            "error"
          ]
        },
        {
          "properties": {
            "op": {
              "const": "end"
            }
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "actor"
                ]
              },
              {
                "required": [
                  "over"
                ]
              },
              {
                "required": [
                  "error"
                ]
              }
            ]
          }
        }
      ]
    },
    "Error": {
      "type": "object",
      "required": [
        "t"
      ],
      "properties": {
        "t": {
          "const": "error"
        },
        "error": {
          "type": "string"
        }
      }
    },
    "Act": {
      "type": "object",
      "required": [
        "t",
        "i"
      ],
      "properties": {
        "t": {
          "const": "act"
        },
        "i": {
          "type": "integer",
          "minimum": 0,
          "description": "Index into decide.actions."
        },
        "split": {
          "$ref": "#/$defs/Split"
        },
        "distribution": {
          "$ref": "#/$defs/Split",
          "description": "v1 name of split."
        }
      }
    },
    "Decide": {
      "type": "object",
      "required": [
        "t",
        "seq",
        "you",
        "prompt",
        "state",
        "actions"
      ],
      "properties": {
        "t": {
          "const": "decide"
        },
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "you": {
          "$ref": "#/$defs/Seat"
        },
        "sim": {
          "type": "boolean",
          "description": "v2: sim requests are allowed for this decision."
        },
        "ms": {
          "$ref": "#/$defs/Ms"
        },
        "prompt": {
          "$ref": "#/$defs/Prompt"
        },
        "state": {
          "$ref": "#/$defs/Observation"
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Action"
          }
        },
        "revealed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlacedRef"
          },
          "description": "Cards revealed to both players since your last decision."
        }
      }
    },
    "Prompt": {
      "type": "object",
      "required": [
        "type",
        "signature",
        "title",
        "promptTitle",
        "selectCardMode",
        "selected",
        "actionWindow"
      ],
      "properties": {
        "type": {
          "type": [
            "string",
            "null"
          ],
          "description": "Engine promptType: initiative, number, resource, actionWindow, displayCards, distributeAmongTargets, triggerWindow, passDelay, batchTriggerResolution, optionalTrigger; null for target selection."
        },
        "signature": {
          "type": "string"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "promptTitle": {
          "type": [
            "string",
            "null"
          ]
        },
        "selectCardMode": {
          "enum": [
            "single",
            "multiple",
            null
          ]
        },
        "selected": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "actionWindow": {
          "type": "boolean"
        },
        "cards": {
          "type": "array",
          "description": "Cards the prompt shows, with their selection state.",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/PlacedRef"
              }
            ],
            "required": [
              "st"
            ],
            "properties": {
              "st": {
                "enum": [
                  "selectable",
                  "selected",
                  "unselectable",
                  "invalid",
                  "viewOnly"
                ]
              }
            }
          }
        }
      }
    },
    "Action": {
      "type": "object",
      "required": [
        "i",
        "kind",
        "label"
      ],
      "properties": {
        "i": {
          "type": "integer",
          "minimum": 0
        },
        "kind": {
          "enum": [
            "button",
            "card",
            "option",
            "displayCard",
            "perCardButton",
            "distribute"
          ]
        },
        "label": {
          "type": "string"
        },
        "arg": {
          "type": [
            "string",
            "number"
          ],
          "description": "Buttons in choice menus can carry a numeric arg; dropdown and number options are strings."
        },
        "cardUuid": {
          "type": "string"
        },
        "card": {
          "$ref": "#/$defs/PlacedRef"
        },
        "distribute": {
          "type": "object",
          "required": [
            "type",
            "amount",
            "canDistributeLess",
            "canChooseNoTargets",
            "maxTargets",
            "tokenType",
            "targets"
          ],
          "properties": {
            "type": {
              "enum": [
                "distributeDamage",
                "distributeIndirectDamage",
                "distributeHealing",
                "distributeTokenUpgrade"
              ]
            },
            "amount": {
              "type": "integer",
              "minimum": 0
            },
            "canDistributeLess": {
              "type": "boolean"
            },
            "canChooseNoTargets": {
              "type": "boolean"
            },
            "maxTargets": {
              "type": [
                "integer",
                "null"
              ]
            },
            "tokenType": {
              "type": [
                "string",
                "null"
              ]
            },
            "targets": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "cap"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "cap": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "null = uncapped."
                  }
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "card"
              }
            }
          },
          "then": {
            "required": [
              "cardUuid",
              "card"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "distribute"
              }
            }
          },
          "then": {
            "required": [
              "distribute"
            ]
          }
        }
      ]
    },
    "CardRef": {
      "type": "object",
      "required": [
        "id",
        "n",
        "s"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Card id: 'c' and a number, stable for the game and the same in replays and simulations. 'hidden' for a card hidden from you (action card refs and prompt.selected only)."
        },
        "n": {
          "type": "string"
        },
        "s": {
          "$ref": "#/$defs/SetCode"
        }
      }
    },
    "PlacedRef": {
      "allOf": [
        {
          "$ref": "#/$defs/CardRef"
        }
      ],
      "required": [
        "zone",
        "ctl"
      ],
      "properties": {
        "zone": {
          "type": [
            "string",
            "null"
          ],
          "description": "hand, groundArena, spaceArena, base, discard, resource, deck, ..."
        },
        "ctl": {
          "oneOf": [
            {
              "$ref": "#/$defs/Seat"
            },
            {
              "type": "null"
            }
          ],
          "description": "Controlling seat."
        }
      }
    },
    "UnitRef": {
      "allOf": [
        {
          "$ref": "#/$defs/CardRef"
        }
      ],
      "required": [
        "p",
        "h",
        "d"
      ],
      "properties": {
        "p": {
          "type": "number"
        },
        "h": {
          "type": "number"
        },
        "d": {
          "type": "number"
        },
        "x": {
          "const": 1
        },
        "sn": {
          "const": 1
        },
        "u": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/CardRef"
              }
            ],
            "required": [
              "t"
            ],
            "properties": {
              "t": {
                "$ref": "#/$defs/Flag"
              }
            }
          }
        },
        "cap": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CardRef"
          },
          "description": "Captured cards."
        }
      }
    },
    "PlayerView": {
      "type": "object",
      "required": [
        "name",
        "base",
        "leader",
        "res",
        "handCount",
        "deck",
        "discard",
        "ground",
        "space"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "base": {
          "allOf": [
            {
              "$ref": "#/$defs/CardRef"
            }
          ],
          "required": [
            "hp",
            "d"
          ],
          "properties": {
            "hp": {
              "type": "number"
            },
            "d": {
              "type": "number"
            },
            "epic": {
              "const": 1,
              "description": "The base's epic action is used."
            }
          }
        },
        "leader": {
          "oneOf": [
            {
              "allOf": [
                {
                  "$ref": "#/$defs/CardRef"
                }
              ],
              "required": [
                "dep",
                "x"
              ],
              "properties": {
                "dep": {
                  "$ref": "#/$defs/Flag"
                },
                "x": {
                  "$ref": "#/$defs/Flag"
                },
                "epic": {
                  "const": 1,
                  "description": "The leader's deploy is used (a defeated leader shows dep 0, epic 1)."
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "res": {
          "type": "object",
          "required": [
            "ready",
            "total"
          ],
          "properties": {
            "ready": {
              "type": "integer"
            },
            "total": {
              "type": "integer"
            }
          }
        },
        "handCount": {
          "type": "integer",
          "minimum": 0
        },
        "force": {
          "const": 1,
          "description": "The player has the Force token."
        },
        "credits": {
          "type": "integer",
          "minimum": 1,
          "description": "Credit tokens, when any."
        },
        "hand": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CardRef"
          },
          "description": "Only on your own player."
        },
        "resources": {
          "type": "array",
          "description": "Only on your own player: resource cards, x: 1 when exhausted.",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/CardRef"
              }
            ],
            "properties": {
              "x": {
                "const": 1
              }
            }
          }
        },
        "deck": {
          "type": "integer",
          "minimum": 0
        },
        "discard": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CardRef"
          }
        },
        "ground": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UnitRef"
          }
        },
        "space": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UnitRef"
          }
        },
        "passed": {
          "const": 1,
          "description": "Action phase: the player passed its last action; the phase ends if the other player passes now."
        },
        "out": {
          "const": 1,
          "description": "Action phase: the player is done for this phase (claimed the initiative, or both passed)."
        }
      }
    },
    "Observation": {
      "type": "object",
      "required": [
        "round",
        "phase",
        "initiative",
        "players"
      ],
      "properties": {
        "round": {
          "type": "integer"
        },
        "phase": {
          "type": [
            "string",
            "null"
          ]
        },
        "initiative": {
          "oneOf": [
            {
              "$ref": "#/$defs/Seat"
            },
            {
              "type": "null"
            }
          ]
        },
        "players": {
          "type": "object",
          "required": [
            "p1",
            "p2"
          ],
          "properties": {
            "p1": {
              "$ref": "#/$defs/PlayerView"
            },
            "p2": {
              "$ref": "#/$defs/PlayerView"
            }
          }
        }
      }
    }
  }
}
