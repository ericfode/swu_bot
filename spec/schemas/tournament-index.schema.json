{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ericfode/swu_bot/spec/schemas/tournament-index.schema.json",
  "title": "SWU bot tournament index (replays/<id>/index.json), format v1",
  "description": "Rewritten whole after every game starts and finishes. Unknown fields must be ignored. See spec/replay-format.md.",
  "type": "object",
  "required": [
    "id",
    "createdAt",
    "engine",
    "bots",
    "gamesPerPairing",
    "games"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Tournament id = directory name."
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "engine": {
      "type": [
        "string",
        "null"
      ]
    },
    "bots": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "gamesPerPairing": {
      "type": "integer",
      "minimum": 0
    },
    "games": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "seed",
          "p1",
          "p2",
          "winner",
          "winnerSeat",
          "rounds",
          "steps",
          "outcome",
          "error",
          "ms"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "<p1>-vs-<p2>-<seed>; the game file is games/<id>.jsonl."
          },
          "seed": {
            "type": "number"
          },
          "p1": {
            "type": "string",
            "description": "Bot name in seat p1."
          },
          "p2": {
            "type": "string"
          },
          "winner": {
            "type": [
              "string",
              "null"
            ],
            "description": "Winning bot name, 'draw', or null."
          },
          "winnerSeat": {
            "enum": [
              "p1",
              "p2",
              "draw",
              null
            ]
          },
          "rounds": {
            "type": "integer",
            "minimum": 0
          },
          "steps": {
            "type": "integer",
            "minimum": 0
          },
          "outcome": {
            "enum": [
              "running",
              "won",
              "STEP_CAP",
              "STUCK",
              "ERROR"
            ]
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "by": {
            "enum": [
              "p1",
              "p2",
              null
            ],
            "description": "For ERROR: the seat whose bot caused it, which loses; null = engine or referee (added)."
          },
          "faultKind": {
            "enum": [
              "load",
              "error",
              "time",
              "hang",
              null
            ],
            "description": "With by, in runs on bot/game-pool.js: how the bot failed (load, error, time cap, watchdog hang); null otherwise (added, optional)."
          },
          "ms": {
            "type": "number",
            "minimum": 0
          },
          "timing": {
            "type": "object",
            "description": "Referee-timed decision milliseconds per seat (added).",
            "required": [
              "p1",
              "p2"
            ],
            "properties": {
              "p1": {
                "$ref": "#/$defs/Timing"
              },
              "p2": {
                "$ref": "#/$defs/Timing"
              }
            }
          },
          "key": {
            "type": "string",
            "description": "The game's own secret key, written when the game ends (bot/ladder.js: once every game on its seed has ended, since the seat-swapped games share it); absent in runs seeded from the seed alone (added)."
          },
          "context": {
            "$ref": "#/$defs/ComparisonContext"
          },
          "bundles": {
            "type": "object",
            "description": "Trusted executor's exact bot name to canonical bundle SHA-256 map for this game (optional, added).",
            "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          },
          "protocols": {
            "type": "object",
            "description": "Accepted numeric bot protocol by seat; no entry for a failed hello or native local bot. Distinct from bot build strings (added).",
            "properties": {
              "p1": { "enum": [1, 2] },
              "p2": { "enum": [1, 2] }
            }
          },
          "requiredProtocol": {
            "enum": [1, 2],
            "description": "Explicit bot protocol required for this game; 2 in the hosted arena (optional, added)."
          },
          "versions": {
            "type": "object",
            "description": "The version string each seat's bot sent in ready, by seat; absent when neither sent one (added).",
            "properties": {
              "p1": {
                "type": "string"
              },
              "p2": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "key": {
      "type": [
        "string",
        "null"
      ],
      "description": "Older indexes only: one secret for the whole run. Newer runs record each game's own key in games[].key."
    }
  },
  "$defs": {
    "ComparisonContext": {
      "type": "object",
      "required": ["schema", "arenaId", "protocol", "engineRevision", "runnerRevision"],
      "properties": {
        "schema": { "const": 1 },
        "arenaId": { "const": "v2" },
        "protocol": { "const": 2 },
        "engineRevision": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "runnerRevision": { "type": "string", "minLength": 1 }
      }
    },
    "Timing": {
      "type": "object",
      "required": [
        "n",
        "ms",
        "p50",
        "p95",
        "max"
      ],
      "properties": {
        "n": {
          "type": "integer",
          "minimum": 0,
          "description": "Decisions."
        },
        "ms": {
          "type": "number",
          "minimum": 0,
          "description": "Total."
        },
        "p50": {
          "type": "number",
          "minimum": 0
        },
        "p95": {
          "type": "number",
          "minimum": 0
        },
        "max": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
